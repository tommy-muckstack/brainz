#!/bin/bash
set -euo pipefail

# Builds a signed, notarized Brainz.dmg for direct download and publishes it
# with the update feed the app polls. Mirrors the My Man / Mumbls pipeline:
#
#   brainz-$VERSION.dmg   immutable versioned artifact (cache 1 year)
#   brainz.dmg            stable alias for muckstack.com/download/brainz
#   brainz-latest.json    {"version": "...", "url": "..."} read by the in-app updater
#
# Also creates a GitHub release with the DMG attached when `gh` is available.
#
# Per-machine values come from script/brainz-local.env (untracked):
#   BRAINZ_NOTARY_PROFILE   notarytool keychain profile (default: mumbls-notary)
#   APPLE_ID / APPLE_APP_PASSWORD / APPLE_TEAM_ID
#                           used instead of the keychain profile when both are set
#   BLOB_READ_WRITE_TOKEN   Vercel Blob token for the muckstack download store
#   BRAINZ_BLOB_HOST        public blob host (default below)
#
# Usage: script/brainz-release [VERSION] [--dry-run] [--skip-notarize] [--no-upload] [--no-github]
# Prereqs: Developer ID Application certificate in the login keychain,
# `create-dmg` (brew), Node for `npx vercel blob`, Rust 1.98.1.

repository=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repository"

VERSION="$(script/brainz-version)"
if [[ -n "${1:-}" && "$1" != --* ]]; then
    if [[ "$1" != "$VERSION" ]]; then
        echo "Requested version $1 does not match BRAINZ_VERSION ($VERSION)." >&2
        exit 1
    fi
    shift
fi
script/brainz-feed --notes "$VERSION" >/dev/null

if [[ -f script/brainz-local.env ]]; then
    set -a
    # shellcheck disable=SC1091
    source script/brainz-local.env
    set +a
fi

SKIP_NOTARIZE=false
NO_UPLOAD=false
NO_GITHUB=false
DRY_RUN=false
for arg in "$@"; do
    case "$arg" in
        --skip-notarize) SKIP_NOTARIZE=true ;;
        --no-upload) NO_UPLOAD=true ;;
        --no-github) NO_GITHUB=true ;;
        --dry-run) DRY_RUN=true; NO_UPLOAD=true; NO_GITHUB=true ;;
        *) echo "unknown flag: $arg" >&2; exit 1 ;;
    esac
done
if $SKIP_NOTARIZE && { ! $NO_UPLOAD || ! $NO_GITHUB; }; then
    echo "Unsigned rehearsal builds require --no-upload and --no-github." >&2
    exit 1
fi
if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
    echo "Commit source changes before building a release." >&2
    exit 1
fi
if [[ -d assets/fonts/gellix ]] && [[ -n "$(find assets/fonts/gellix -type f -print -quit)" ]]; then
    echo "Local Gellix assets are present and would be embedded."
    if [[ "${BRAINZ_ALLOW_GELLIX:-0}" != 1 ]]; then
        echo "Use a clean checkout for redistributable DM Sans builds, or set BRAINZ_ALLOW_GELLIX=1 after confirming redistribution rights." >&2
        exit 1
    fi
else
    echo "Bundled font: DM Sans; installed Gellix remains available at runtime."
fi

SLUG="brainz"
APP_NAME="Brainz"
NOTARY_PROFILE="${BRAINZ_NOTARY_PROFILE:-mumbls-notary}"
BLOB_HOST="${BRAINZ_BLOB_HOST:-https://ihvfw4x5q9iy9zx1.public.blob.vercel-storage.com}"
BUILD_NUMBER="$(git rev-list --count HEAD)"
RELEASE_COMMIT="$(git rev-parse HEAD)"
DIST="$repository/target/release-$VERSION"
APP_DIR="$DIST/$APP_NAME.app"
DMG_PATH="$DIST/$SLUG-$VERSION.dmg"
CHANNEL=stable
FEED_NAME="$SLUG-latest.json"
if [[ "$VERSION" == *-preview.* ]]; then
    CHANNEL=preview
    FEED_NAME="$SLUG-preview.json"
fi
FEED_PATH="$DIST/$FEED_NAME"
if [[ -e "$DIST" ]]; then
    echo "Release output already exists: $DIST. Preserve or move it before rebuilding." >&2
    exit 1
fi

export PATH="${HOME}/.cargo/bin:${PATH}"
# notarytool and stapler need the full Xcode; cargo is happier with the
# command line tools, so each step picks its own DEVELOPER_DIR.
XCODE_DEV="/Applications/Xcode.app/Contents/Developer"
CLT_DEV="/Library/Developer/CommandLineTools"

DEV_ID_IDENTITY=$(security find-identity -v -p codesigning | grep "Developer ID Application" | head -1 | awk -F'"' '{print $2}')
if [[ -z "$DEV_ID_IDENTITY" ]]; then
    echo "ERROR: no 'Developer ID Application' certificate in the keychain" >&2
    exit 1
fi
echo "==> Brainz $VERSION (build $BUILD_NUMBER), signing as: $DEV_ID_IDENTITY"

echo "==> Release build (this takes a while)..."
export DEVELOPER_DIR="$CLT_DEV"
export SDKROOT="$(xcrun --sdk macosx --show-sdk-path)"
# Panic locations and debug paths otherwise embed the builder's home folder
# and the checkout path in the shipped binary; map them to neutral roots.
REMAP_FLAGS="--remap-path-prefix=$repository=/brainz --remap-path-prefix=${HOME}/.cargo=/cargo --remap-path-prefix=${HOME}=/home"
BRAINZ_VERSION="$VERSION" ZED_BUILD_ID="$BUILD_NUMBER" ZED_COMMIT_SHA="$RELEASE_COMMIT" CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-3}" \
    RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }$REMAP_FLAGS" \
    cargo +1.98.1 build --locked --release -p zed -p cli --bin brainz --bin cli \
    --features util/debug-embed,gpui_platform/runtime_shaders

echo "==> Bundling $APP_NAME.app..."
mkdir -p "$DIST"
BRAINZ_NO_OPEN=1 BRAINZ_APP_DIR="$APP_DIR" BRAINZ_BINARY="$repository/target/release/brainz" \
    BRAINZ_CLI_BINARY="$repository/target/release/cli" \
    BRAINZ_VERSION="$VERSION" BRAINZ_BUILD="$BUILD_NUMBER" BRAINZ_SIGNING_IDENTITY="" \
    script/brainz-local --no-build

echo "==> Signing with Developer ID and the hardened runtime..."
ENTITLEMENTS="$repository/crates/zed/resources/zed.entitlements"
codesign --force --timestamp --options runtime --sign "$DEV_ID_IDENTITY" \
    "$APP_DIR/Contents/MacOS/brainz-calendar"
codesign --force --timestamp --options runtime --sign "$DEV_ID_IDENTITY" \
    "$APP_DIR/Contents/MacOS/brainz-ocr"
codesign --force --timestamp --options runtime --sign "$DEV_ID_IDENTITY" \
    "$APP_DIR/Contents/MacOS/brainz-pdf"
codesign --force --timestamp --options runtime --sign "$DEV_ID_IDENTITY" \
    "$APP_DIR/Contents/MacOS/cli"
codesign --force --timestamp --options runtime --entitlements "$ENTITLEMENTS" \
    --sign "$DEV_ID_IDENTITY" "$APP_DIR/Contents/MacOS/brainz"
codesign --force --timestamp --options runtime --entitlements "$ENTITLEMENTS" \
    --sign "$DEV_ID_IDENTITY" "$APP_DIR"
codesign --verify --deep --strict --verbose=2 "$APP_DIR"

# The keychain profile has vanished mid-release more than once, so when
# APPLE_ID and APPLE_APP_PASSWORD are set in script/brainz-local.env they are
# used directly instead (the same shape My Man's build script uses).
notarize() {
    local path="$1" attempt
    for attempt in 1 2 3; do
        if [[ -n "${BRAINZ_NOTARY_KEY:-}" ]]; then
            DEVELOPER_DIR="$XCODE_DEV" xcrun notarytool submit "$path" \
                --key "$BRAINZ_NOTARY_KEY" --key-id "$BRAINZ_NOTARY_KEY_ID" \
                --issuer "$BRAINZ_NOTARY_ISSUER" --no-s3-acceleration --wait && return 0
        elif [[ -n "${APPLE_ID:-}" && -n "${APPLE_APP_PASSWORD:-}" ]]; then
            DEVELOPER_DIR="$XCODE_DEV" xcrun notarytool submit "$path" \
                --apple-id "$APPLE_ID" --team-id "${APPLE_TEAM_ID:-K8NAZ76CBQ}" \
                --password "$APPLE_APP_PASSWORD" --no-s3-acceleration --wait && return 0
        else
            DEVELOPER_DIR="$XCODE_DEV" xcrun notarytool submit "$path" \
                --keychain-profile "$NOTARY_PROFILE" --no-s3-acceleration --wait && return 0
        fi
        echo "==> notarization attempt $attempt failed; retrying in 20s..." >&2
        sleep 20
    done
    echo "ERROR: notarization failed after 3 attempts" >&2
    return 1
}

if $SKIP_NOTARIZE; then
    echo "==> Skipping notarization (--skip-notarize)"
else
    echo "==> Notarizing app (2-10 minutes)..."
    ZIP_PATH="$DIST/$SLUG-notarize.zip"
    /usr/bin/ditto -c -k --keepParent "$APP_DIR" "$ZIP_PATH"
    notarize "$ZIP_PATH"
    rm -f "$ZIP_PATH"
    DEVELOPER_DIR="$XCODE_DEV" xcrun stapler staple "$APP_DIR"
fi

echo "==> Creating DMG..."
rm -f "$DMG_PATH"
if ! create-dmg \
    --volname "$APP_NAME $VERSION" \
    --window-size 540 360 \
    --icon-size 96 \
    --icon "$APP_NAME.app" 140 180 \
    --app-drop-link 400 180 \
    --hide-extension "$APP_NAME.app" \
    --no-internet-enable \
    "$DMG_PATH" "$APP_DIR"
then
    echo "==> create-dmg failed; falling back to hdiutil..."
    rm -f "$DMG_PATH"
    STAGE="$DIST/.dmg-stage"
    rm -rf "$STAGE"
    mkdir -p "$STAGE"
    cp -aR "$APP_DIR" "$STAGE/"
    ln -s /Applications "$STAGE/Applications"
    hdiutil create -volname "$APP_NAME $VERSION" -srcfolder "$STAGE" -ov -format UDZO "$DMG_PATH"
    rm -rf "$STAGE"
fi

if ! $SKIP_NOTARIZE; then
    echo "==> Signing, notarizing, and stapling the DMG..."
    codesign --force --timestamp --sign "$DEV_ID_IDENTITY" "$DMG_PATH"
    notarize "$DMG_PATH"
    DEVELOPER_DIR="$XCODE_DEV" xcrun stapler staple "$DMG_PATH"
fi

VERSIONED_URL="$BLOB_HOST/$SLUG-$VERSION.dmg"
script/brainz-feed --version "$VERSION" --artifact "$DMG_PATH" --url "$VERSIONED_URL" \
    --commit "$RELEASE_COMMIT" --rollout "${BRAINZ_ROLLOUT:-100}" --output "$FEED_PATH"
script/brainz-feed --notes "$VERSION" > "$DIST/release-notes.md"
if ! $SKIP_NOTARIZE; then
    script/brainz-smoke "$APP_DIR" "$DMG_PATH"
fi

verify_download() {
    local url="$1" downloaded="$DIST/download-check.dmg" attempt
    for attempt in 1 2 3 4 5 6; do
        if curl --fail --silent --show-error --location --max-time 300 "$url" -o "$downloaded" && cmp -s "$DMG_PATH" "$downloaded"; then
            rm -f "$downloaded"
            return 0
        fi
        sleep 10
    done
    echo "Published artifact did not match the notarized DMG; feed left unchanged." >&2
    return 1
}

if $NO_UPLOAD; then
    echo "==> Upload skipped (--no-upload)"
elif [[ -n "${BLOB_READ_WRITE_TOKEN:-}" ]]; then
    echo "==> Uploading to Vercel Blob..."
    npx --yes vercel@51.6.1 blob put "$DMG_PATH" --pathname "$SLUG-$VERSION.dmg" \
        --access public --allow-overwrite false --content-type application/x-apple-diskimage \
        --cache-control-max-age 31536000
    verify_download "$VERSIONED_URL"
else
    echo "BLOB_READ_WRITE_TOKEN is required to publish. Use --no-upload for a local build." >&2
    exit 1
fi

if ! $NO_GITHUB && command -v gh >/dev/null 2>&1; then
    # This is a fork, so `gh` would otherwise target upstream Zed.
    GH_REPO="$(git remote get-url origin | sed -E 's#.*github.com[:/]##; s#\.git$##')"
    echo "==> Creating GitHub release v$VERSION on $GH_REPO..."
    if gh release view "v$VERSION" --repo "$GH_REPO" >/dev/null 2>&1; then
        echo "Release v$VERSION already exists; refusing to overwrite it." >&2
        exit 1
    else
        prerelease_flag=()
        if [[ "$CHANNEL" == preview ]]; then prerelease_flag=(--prerelease); fi
        gh release create "v$VERSION" "$DMG_PATH" --repo "$GH_REPO" --title "Brainz $VERSION" \
            --target "$RELEASE_COMMIT" \
            --notes-file "$DIST/release-notes.md" ${prerelease_flag[@]+"${prerelease_flag[@]}"}
    fi
fi

if ! $NO_UPLOAD; then
    if [[ "$CHANNEL" == stable ]]; then
        npx --yes vercel@51.6.1 blob put "$DMG_PATH" --pathname "$SLUG.dmg" \
            --access public --allow-overwrite true --content-type application/x-apple-diskimage --cache-control-max-age 300
        verify_download "$BLOB_HOST/$SLUG.dmg"
    fi
    npx --yes vercel@51.6.1 blob put "$FEED_PATH" --pathname "$FEED_NAME" \
        --access public --allow-overwrite true --content-type application/json --cache-control-max-age 300
fi

echo ""
echo "✓ Done."
echo "  App:    $APP_DIR"
echo "  DMG:    $DMG_PATH"
echo "  Feed:   $FEED_PATH"
echo "  Latest: $BLOB_HOST/$SLUG.dmg"
